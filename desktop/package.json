{
  "name": "crea-studio",
  "version": "0.2.0",
  "description": "Editor video desktop semplice con timeline e registrazione schermo",
  "author": "Crea Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --x64 --dir --publish never && node scripts/make-installer.cjs",
    "test:ui": "node test/ui-smoke.cjs",
    "prebuild:win": "node scripts/prepare-windows.cjs",
    "bundle:release": "node scripts/bundle-release.cjs",
    "build:release": "npm run build:win && npm run bundle:release"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "it.crea.studio",
    "productName": "Crea Studio",
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg",
        "!node_modules/ffprobe-static/bin/linux/**/*",
        "!node_modules/ffprobe-static/bin/darwin/**/*",
        "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Crea-Studio-${version}-${arch}-Setup.${ext}"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Wydadista/crea.git"
  }
}
