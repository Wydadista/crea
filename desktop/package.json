{
  "name": "akhbar-studio",
  "version": "0.4.5",
  "description": "Editor video desktop semplice con timeline e registrazione schermo",
  "author": "AKhbar studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --x64 --dir --publish never && node scripts/make-installer.cjs",
    "test:ui": "node test/ui-smoke.cjs && node test/features-ui.cjs && node test/precision-ui.cjs && node test/workflow-ui.cjs",
    "prebuild:win": "node scripts/prepare-windows.cjs && node --use-env-proxy scripts/prepare-deepfilter.cjs win32",
    "bundle:release": "node scripts/bundle-release.cjs",
    "build:release": "npm run build:win && npm run bundle:release",
    "test:akhbar": "node test/akhbar-ui.cjs",
    "test:scrub": "node test/scrub-ui.cjs",
    "test:editing": "node test/editing-ui.cjs",
    "test:detach": "node test/detach-height-ui.cjs",
    "test:recording-quality": "node test/recording-quality-ui.cjs",
    "test:workflow-editing": "node test/workflow-editing-ui.cjs",
    "postinstall": "node --use-env-proxy scripts/prepare-deepfilter.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "it.crea.studio",
    "productName": "AKhbar studio",
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg",
        "!node_modules/ffprobe-static/bin/linux/**/*",
        "!node_modules/ffprobe-static/bin/darwin/**/*",
        "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
      ],
      "signExecutable": false,
      "icon": "src/project-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "AKhbar-studio-${version}-${arch}-Setup.${ext}",
    "extraResources": [
      {
        "from": "vendor/deepfilter/win32",
        "to": "vendor/deepfilter/win32"
      }
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Wydadista/crea.git"
  }
}
